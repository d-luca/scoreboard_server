{
	"name": "scoreboard_server",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"scripts": {
		"dev": "tauri dev",
		"build": "tauri build",
		"build:debug": "tauri build --debug",
		"vite:dev": "vite",
		"vite:build": "tsc --noEmit && vite build",
		"bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings -- --ignored && prettier --write --ignore-path .prettierignore src/bindings",
		"lint": "eslint .",
		"format": "prettier --write .",
		"rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
		"rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
		"check": "pnpm lint && pnpm vite:build && pnpm rust:clippy && pnpm rust:test",
		"tauri": "tauri"
	},
	"dependencies": {
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config-prettier": "^3.0.0",
		"@electron-toolkit/eslint-config-ts": "^3.1.0",
		"@tauri-apps/cli": "^2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"typescript": "~5.8.3",
		"vite": "^7.0.4"
	}
}
